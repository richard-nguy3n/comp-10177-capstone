# Send a copy of all system/application messages collected by rsyslog
# to MGMT01 at 192.168.30.10 over TCP port 514.
#
# Keep retrying if MGMT01's log receiver is unavailable.
# Queue messages and save the queue during a clean shutdown.
# Central log delivery will be tested when the receiver is configured.
*.* action(
  type="omfwd"
  target="192.168.30.10"
  port="514"
  protocol="tcp"
  action.resumeRetryCount="-1"
  queue.type="LinkedList"
  queue.filename="capstoneforward"
  queue.saveOnShutdown="on"
)
